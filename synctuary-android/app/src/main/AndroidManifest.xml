<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network access is the entire point of the app — no point gating it.
        Android Q+ gates "cleartext" traffic; we keep usesCleartextTraffic=false
        as a forcing function: any non-TLS server connection has to be opted
        into per-host via network_security_config.xml at code-review time, not
        as a global flag. PROTOCOL §10 dev-plaintext servers will need that
        explicit opt-in.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera: QR code scanning for server pairing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- BiometricPrompt requires this; falls back to PIN/passcode automatically. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Photo auto-backup: read images/video from MediaStore (API 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Pre-API 33 fallback. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        All-files access for the Device-tab file browser.

        Android 11+ blocks ACTION_OPEN_DOCUMENT_TREE from granting the
        Download directory, the internal-storage root, and SD-card roots,
        so SAF alone cannot browse the places users most often keep files.
        MANAGE_EXTERNAL_STORAGE is the only API that can.

        It is OPTIONAL and never requested silently: the app works purely
        on SAF grants without it, and the user has to enable it in system
        Settings. `tools:ignore` silences the lint warning — the file-
        manager use case is exactly what Play's policy carves out, and
        distribution there would need the corresponding declaration.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Foreground service for long-running backup uploads. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SynctuaryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Synctuary"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="34">

        <!--
            Files listed through all-files access are plain paths, but
            handing another app a file:// URI throws
            FileUriExposedException — open/share/upload all go through
            this provider instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Synctuary"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
